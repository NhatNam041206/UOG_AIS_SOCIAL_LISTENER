 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Phase 4 Overview Notebook: Spatial-Temporal Aggregation Matrices\n",
    "\n",
    "This notebook provides an interactive environment to inspect and examine Phase 4 aggregated matrices:\n",
    "1. **Temporal Matrix**: Hourly and daily volume ($N_t$), mean sentiment ($\mu_t$), and polarization ($\sigma_t$).\n",
    "2. **Event Windows**: Timeline slices surrounding political shocks ($T_t, D_t$).\n",
    "3. **Spatial Matrix**: State candidate sentiment margins ($X_i = \\bar{S}_{\\text{Biden}, i} - \\bar{S}_{\\text{Trump}, i}$) merged with 2020 election returns ($Y_i$) and demographic controls ($Z_{ki}$)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "sns.set_theme(style=\"whitegrid\", context=\"notebook\")\n",
    "PROJECT_ROOT = Path(\"..\").resolve()\n",
    "P4_DATA_DIR = PROJECT_ROOT / \"data\" / \"03_processed\"\n",
    "P4_RESULTS_DIR = PROJECT_ROOT / \"output\" / \"results\" / \"phase4\"\n",
    "\n",
    "manifest = json.loads((P4_RESULTS_DIR / \"aggregation_manifest.json\").read_text())\n",
    "print(\"Phase 4 Manifest Summary:\")\n",
    "print(json.dumps(manifest, indent=2))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Inspect Temporal Hourly Matrix ($N_t, \\mu_t, \\sigma_t$)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "hourly_df = pd.read_parquet(P4_DATA_DIR / \"temporal_hourly_matrix.parquet\")\n",
    "print(f\"Total Hourly Slices: {len(hourly_df):,}\")\n",
    "hourly_df.head(5)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(12, 4))\n",
    "plt.plot(hourly_df[\"timestamp_hourly\"], hourly_df[\"mean_sentiment\"], color=\"#3977C3\", linewidth=1.5)\n",
    "plt.title(\"Hourly Mean Sentiment Timeline (Oct 15 - Nov 8, 2020)\", fontsize=14, fontweight=\"bold\")\n",
    "plt.xlabel(\"Hour (UTC)\", fontsize=12)\n",
    "plt.ylabel(\"Mean Sentiment Valence\", fontsize=12)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Inspect State Spatial Matrix ($X_i, Y_i, Z_{ki}$)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "spatial_df = pd.read_parquet(P4_DATA_DIR / \"spatial_state_matrix.parquet\")\n",
    "print(f\"State Matrix Rows: {len(spatial_df):,} (50 States + DC)\")\n",
    "spatial_df[[\"state_code\", \"historical_classification\", \"biden_mean_sentiment\", \"trump_mean_sentiment\", \"state_sentiment_margin_Xi\", \"democratic_margin_pct_2020\"]].head(10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(12, 6))\n",
    "sorted_spatial = spatial_df.sort_values(\"state_sentiment_margin_Xi\")\n",
    "colors = [\"#D94B4B\" if val < 0 else \"#3977C3\" for val in sorted_spatial[\"state_sentiment_margin_Xi\"]]\n",
    "plt.barh(sorted_spatial[\"state_code\"], sorted_spatial[\"state_sentiment_margin_Xi\"], color=colors)\n",
    "plt.title(\"State Online Candidate Sentiment Margin (Xi = Biden Mean - Trump Mean)\", fontsize=14, fontweight=\"bold\")\n",
    "plt.xlabel(\"Online Sentiment Margin Xi\", fontsize=12)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
 ],
